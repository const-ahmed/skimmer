{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skimmer",
  "compatibility_date": "2026-09-26",
  // nodejs_compat is required by the TanStack Start server runtime; application
  // code uses Web APIs only. enable_request_signal lets a closed client connection abort the analysis.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "9713fe65eac43ed94a53a3cc446579e5",
    "AI_GATEWAY_ID": "skimmer",
  },
  "ratelimits": [
    {
      "name": "ANALYSIS_RATE_LIMITER",
      "namespace_id": "4101",
      "simple": {
        "limit": 3,
        "period": 60,
      },
    },
  ],
  // Names only. Set values with `wrangler secret put`; locally they come from the git-ignored .env.
  // Local dev exposes only the secrets listed here, so every secret the Worker reads must be listed.
  "secrets": {
    "required": ["GITHUB_API_TOKEN", "CF_AIG_TOKEN", "TURNSTILE_SECRET"],
  },
}
